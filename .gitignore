node_modules/
dist/
*.tsbuildinfo

# Local toolchain: everything in tools/ except the README and our scripts
tools/*
!tools/README.md
!tools/scripts/

# Raw downloaded data (never committed)
data/raw/*
!data/raw/README.md

# Python
