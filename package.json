{
  "name": "analoglens",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AnalogLens: Earth analogs for Moon and Mars sites, explained dimension by dimension (NASA Space Apps 2026).",
  "scripts": {
    "setup": "node tools/scripts/setup.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:sources": "tsx tools/scripts/check-sources.ts",
    "textures": "node tools/scripts/py.mjs tools/scripts/build_textures.py",
    "data:publish": "tsx tools/scripts/publish-data.ts",
    "pipeline:test": "node tools/scripts/py.mjs tests/test_core.py",
    "verify": "npm run typecheck && npm run lint && npm test && npm run pipeline:test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
