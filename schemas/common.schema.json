{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analog-finder.contract/schemas/common.schema.json",
  "title": "Analog Finder shared definitions (contract v1.0)",
  "$defs": {
    "schema_version": { "const": "1.0" },
    "body": { "enum": ["earth", "moon", "mars"] },
    "planetary_body": { "enum": ["moon", "mars"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "header": {
      "description": "Every contract file carries this header. Mock files MUST set mock=true and explain how they were generated in `note`.",
      "type": "object",
      "required": ["schema_version", "mock", "generated_at", "generator"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "mock": { "type": "boolean" },
        "note": { "type": "string", "minLength": 10 },
        "generated_at": { "type": "string", "format": "date-time" },
        "generator": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "mock": { "const": true } } },
      "then": { "required": ["note"] }
    },
    "nullable_number": { "type": ["number", "null"] },
    "target_features": {
      "description": "Physical units, identical meaning on every body. null = no data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["elevation_m", "slope_deg", "roughness", "temp_range_k", "mineral_index", "ice_indicator"],
      "properties": {
        "elevation_m": { "type": ["number", "null"], "minimum": -12000, "maximum": 30000 },
        "slope_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 90 },
        "roughness": { "type": ["number", "null"], "minimum": 0, "maximum": 5000 },
        "temp_range_k": { "type": ["number", "null"], "minimum": 0, "maximum": 400 },
        "mineral_index": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "ice_indicator": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "earth_features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elevation_m", "slope_deg", "roughness", "temp_range_k", "mineral_index", "ice_indicator", "ndvi"],
      "properties": {
        "elevation_m": { "type": ["number", "null"], "minimum": -500, "maximum": 9000 },
        "slope_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 90 },
        "roughness": { "type": ["number", "null"], "minimum": 0, "maximum": 5000 },
        "temp_range_k": { "type": ["number", "null"], "minimum": 0, "maximum": 400 },
        "mineral_index": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "ice_indicator": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "ndvi": { "type": ["number", "null"], "minimum": -1, "maximum": 1 }
      }
    },
    "comparable_feature": {
      "enum": ["elevation_m", "slope_deg", "roughness", "temp_range_k", "mineral_index", "ice_indicator"]
    },
    "feature_provenance": {
      "description": "Maps a feature name to the provenance dataset id it came from.",
      "type": "object",
      "propertyNames": { "enum": ["elevation_m", "slope_deg", "roughness", "temp_range_k", "mineral_index", "ice_indicator", "ndvi"] },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elevation_m", "slope_deg", "roughness", "temp_range_k", "mineral_index", "ice_indicator"],
      "properties": {
        "elevation_m": { "type": "number", "minimum": 0, "maximum": 10 },
        "slope_deg": { "type": "number", "minimum": 0, "maximum": 10 },
        "roughness": { "type": "number", "minimum": 0, "maximum": 10 },
        "temp_range_k": { "type": "number", "minimum": 0, "maximum": 10 },
        "mineral_index": { "type": "number", "minimum": 0, "maximum": 10 },
        "ice_indicator": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "scales": {
      "description": "Fixed physical scale per feature (same unit as the feature). Identical for every body: NOT per-body percentiles.",
      "type": "object",
      "additionalProperties": false,
      "required": ["elevation_m", "slope_deg", "roughness", "temp_range_k", "mineral_index", "ice_indicator"],
      "properties": {
        "elevation_m": { "type": "number", "exclusiveMinimum": 0 },
        "slope_deg": { "type": "number", "exclusiveMinimum": 0 },
        "roughness": { "type": "number", "exclusiveMinimum": 0 },
        "temp_range_k": { "type": "number", "exclusiveMinimum": 0 },
        "mineral_index": { "type": "number", "exclusiveMinimum": 0 },
        "ice_indicator": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
