{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analog-finder.contract/schemas/validation_report.schema.json",
  "title": "validation_report.json — where each known analog lands in each target's ranking",
  "allOf": [{ "$ref": "common.schema.json#/$defs/header" }],
  "type": "object",
  "required": ["match_radius_km", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": true,
    "mock": true,
    "note": true,
    "generated_at": true,
    "generator": true,
    "match_radius_km": { "type": "number", "exclusiveMinimum": 0, "description": "A candidate within this distance of a known analog counts as that analog." },
    "targets": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pool_size", "entries"],
        "properties": {
          "pool_size": { "type": "integer", "minimum": 0 },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["known_analog_id", "name", "rank", "matched_candidate_id", "match_distance_km"],
              "properties": {
                "known_analog_id": { "$ref": "common.schema.json#/$defs/id" },
                "name": { "type": "string" },
                "rank": { "type": ["integer", "null"], "minimum": 1, "description": "null = not in the pool / excluded." },
                "matched_candidate_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
                "match_distance_km": { "type": ["number", "null"], "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
