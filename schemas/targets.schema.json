{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analog-finder.contract/schemas/targets.schema.json",
  "title": "targets.json — lunar and Martian target sites and their fingerprints",
  "allOf": [{ "$ref": "common.schema.json#/$defs/header" }],
  "type": "object",
  "required": ["targets"],
  "properties": {
    "schema_version": true,
    "mock": true,
    "note": true,
    "generated_at": true,
    "generator": true,
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "body", "lat", "lon", "radius_km", "description", "coords_verified", "features", "provenance"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "body": { "$ref": "common.schema.json#/$defs/planetary_body" },
          "lat": { "$ref": "common.schema.json#/$defs/lat" },
          "lon": { "$ref": "common.schema.json#/$defs/lon" },
          "radius_km": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000, "description": "Fingerprint radius: features are the mean within this distance of (lat, lon)." },
          "description": { "type": "string" },
          "coords_verified": { "type": "boolean", "description": "false until someone has checked lat/lon against the IAU Gazetteer or mission documentation." },
          "features": { "$ref": "common.schema.json#/$defs/target_features" },
          "provenance": { "$ref": "common.schema.json#/$defs/feature_provenance" }
        }
      }
    }
  },
  "additionalProperties": false
}
