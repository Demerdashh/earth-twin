{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analog-finder.contract/schemas/analogs.schema.json",
  "title": "analogs_<target_id>.geojson — ranked Earth analogs for one target (pipeline default weights)",
  "allOf": [{ "$ref": "common.schema.json#/$defs/header" }],
  "type": "object",
  "required": ["type", "target_id", "weights", "features"],
  "additionalProperties": false,
  "properties": {
    "schema_version": true,
    "mock": true,
    "note": true,
    "generated_at": true,
    "generator": true,
    "type": { "const": "FeatureCollection" },
    "target_id": { "$ref": "common.schema.json#/$defs/id" },
    "weights": { "$ref": "common.schema.json#/$defs/weights" },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "Point" },
              "coordinates": {
                "type": "array",
                "prefixItems": [{ "$ref": "common.schema.json#/$defs/lon" }, { "$ref": "common.schema.json#/$defs/lat" }],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "name", "rank", "score", "distance", "known_analog_id", "excluded_by_vegetation"],
            "properties": {
              "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
              "name": { "type": "string" },
              "rank": { "type": ["integer", "null"], "minimum": 1, "description": "null when the candidate is excluded by the vegetation filter." },
              "score": { "type": "number", "minimum": 0, "maximum": 1 },
              "distance": { "type": "number", "minimum": 0 },
              "known_analog_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
              "excluded_by_vegetation": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
