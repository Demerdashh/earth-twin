{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analog-finder.contract/schemas/provenance.schema.json",
  "title": "provenance.json — where every number comes from",
  "allOf": [{ "$ref": "common.schema.json#/$defs/header" }],
  "type": "object",
  "required": ["datasets", "runs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": true,
    "mock": true,
    "note": true,
    "generated_at": true,
    "generator": true,
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "body", "source", "product", "resolution", "date", "processing_steps", "url", "verified", "mock"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "body": { "$ref": "common.schema.json#/$defs/body" },
          "source": { "type": "string", "description": "Organisation / portal, e.g. 'NASA Moon Trek', 'Google Earth Engine'." },
          "product": { "type": "string", "description": "Exact product / dataset identifier." },
          "resolution": { "type": "string", "description": "Native resolution with unit, e.g. '118 m/px'." },
          "date": { "type": "string", "description": "Acquisition or release date / range (ISO 8601 where possible)." },
          "processing_steps": { "type": "array", "items": { "type": "string" } },
          "url": { "type": ["string", "null"], "format": "uri" },
          "verified": { "type": "boolean", "description": "true only after availability and resolution were checked at the source." },
          "mock": { "type": "boolean" }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "mode", "started_at", "config_sha256", "seed", "outputs"],
        "properties": {
          "run_id": { "type": "string" },
          "mode": { "enum": ["mock", "real"] },
          "started_at": { "type": "string", "format": "date-time" },
          "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "seed": { "type": ["integer", "null"] },
          "outputs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
